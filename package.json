{
  "name": "codeladder",
  "displayName": "CodeLadder · Four-tier Code Reading",
  "description": "CodeLadder turns Python, TypeScript, C, C++, Java, Rust and Go into four readable tiers — intent (L1), steps (L2), logic (L3) and code (L4). Made for AI-assisted developers who ship code they can't fully read, and for anyone learning an unfamiliar codebase.",
  "version": "0.1.2",
  "publisher": "codeladder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/white8tterfly/codeladder.git"
  },
  "bugs": {
    "url": "https://github.com/white8tterfly/codeladder/issues"
  },
  "homepage": "https://github.com/white8tterfly/codeladder#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f3d3a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "readability",
    "explain",
    "python",
    "typescript",
    "java",
    "rust",
    "go",
    "c",
    "cpp",
    "learning",
    "education",
    "vibe-coding",
    "code-comprehension",
    "tree-sitter",
    "non-developer"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:java",
    "onLanguage:rust",
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeReadable.explain",
        "title": "%cmd.explain%",
        "category": "CodeLadder",
        "icon": "$(book)"
      },
      {
        "command": "codeReadable.refresh",
        "title": "%cmd.refresh%",
        "category": "CodeLadder"
      },
      {
        "command": "codeReadable.rebuildIndex",
        "title": "%cmd.rebuildIndex%",
        "category": "CodeLadder"
      }
    ],
    "configuration": {
      "title": "CodeLadder",
      "properties": {
        "codeLadder.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh%",
            "%config.language.en%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language.desc%"
        },
        "codeLadder.llm.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.llm.baseUrl.desc%"
        },
        "codeLadder.llm.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.llm.apiKey.desc%"
        },
        "codeLadder.llm.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.llm.model.desc%"
        },
        "codeLadder.llm.maxInputChars": {
          "type": "number",
          "default": 24000,
          "minimum": 2000,
          "markdownDescription": "%config.llm.maxInputChars.desc%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "codeReadable.explain",
          "when": "resourceLangId == python || resourceLangId == typescript || resourceLangId == typescriptreact || resourceLangId == c || resourceLangId == cpp || resourceLangId == java || resourceLangId == rust || resourceLangId == go",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "codeReadable.explain",
          "when": "resourceLangId == python || resourceLangId == typescript || resourceLangId == typescriptreact || resourceLangId == c || resourceLangId == cpp || resourceLangId == java || resourceLangId == rust || resourceLangId == go",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "selftest": "node out/selftest.js",
    "package": "npx --yes @vscode/vsce package",
    "publish:vsce": "npx --yes @vscode/vsce publish",
    "publish:ovsx": "npx --yes ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "web-tree-sitter": "0.20.8",
    "tree-sitter-wasms": "0.1.13"
  }
}
